<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.capcom.client</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Capcom.app/Contents/MacOS/capcom</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after "Quit Capcom" in the menu (clean exit 0). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/Capcom.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/Capcom.log</string>
</dict>
</plist>
